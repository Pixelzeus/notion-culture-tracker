{
  "manifest_version": 3,
  "name": "Culture Tracker - TMDb, TheGamesDB & Notion",
  "version": "1.4.0",
  "description": "Ajoutez rapidement vos films, séries et jeux vidéo dans votre espace Notion Tracking Culture avec The Movie Database (TMDb) et TheGamesDB.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Culture Tracker - TMDb, TheGamesDB & Notion"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.notion.so/*",
        "https://notion.so/*",
        "https://app.notion.com/*"
      ],
      "js": ["content/notion-inject.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/popup.html",
        "popup/popup.css",
        "popup/popup.js",
        "services/*",
        "icons/*",
        "content/*",
        "config/*"
      ],
      "matches": [
        "https://www.notion.so/*",
        "https://notion.so/*",
        "https://app.notion.com/*"
      ]
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "tabs"
  ],
  "host_permissions": [
    "https://api.themoviedb.org/*",
    "https://api.notion.com/*",
    "https://image.tmdb.org/*",
    "https://api.thegamesdb.net/*",
    "https://cdn.thegamesdb.net/*",
    "https://store.steampowered.com/*",
    "https://cdn.akamai.steamstatic.com/*",
    "https://shared.fastly.steamstatic.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "culture-tracker-notion@pixelzeus.local",
      "strict_min_version": "109.0"
    }
  }
}
